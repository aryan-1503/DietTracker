{
    "include":  [
                    "**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ],
    "compilerOptions":  {
                            "outDir":  "./dist",
                            "strict":  false,
                            "module":  "commonjs",
                            "rootDir":  ".",
                            "esModuleInterop":  true,
                            "target":  "ES2020",
                            "resolveJsonModule":  true,
                            "lib":  [
                                        "ES2020"
                                    ]
                        }
}
